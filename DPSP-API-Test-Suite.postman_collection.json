	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-generate timestamps and random values",
					"pm.globals.set('timestamp', new Date().toISOString());",
					"pm.globals.set('randomInt', Math.floor(Math.random() * 10000));"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Basic response validation",
					"pm.test('Status code is successful', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
					"});",
					"",
					"pm.test('Response has success field', function () {",
					"    const jsonData = pm.response.json();",
					"    pm.expect(jsonData).to.have.property('success');",
					"});",
					"",
					"pm.test('Response time is less than 2000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(2000);",
					"});",
					"",
					"// Extract IDs for subsequent requests",
					"if (pm.response.json() && pm.response.json().data) {",
					"    const data = pm.response.json().data;",
					"    if (data.id) {",
					"        pm.globals.set('transaction_id', data.id);",
					"    }",
					"    if (data.user_id) {",
					"        pm.globals.set('user_id', data.user_id);",
					"    }",
					"    if (data.account_number) {",
					"        pm.globals.set('account_number', data.account_number);",
					"    }",
					"    if (data.report_id) {",
					"        pm.globals.set('report_id', data.report_id);",
					"    }",
					"    if (data.replay_id) {",
					"        pm.globals.set('replay_id', data.replay_id);",
					"    }",
					"    if (data.safe_replay_id) {",
					"        pm.globals.set('safe_replay_id', data.safe_replay_id);",
					"    }",
					"    if (data.anomaly_id) {",
					"        pm.globals.set('anomaly_id', data.anomaly_id);",
					"    }",
					"}"
				]
			}
		}
